{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/profile",
      "destination": "/profile.html"
    },
    {
      "source": "/profile/:user",
      "destination": "/profile.html?user=:user"
    },
    {
      "source": "/callback",
      "destination": "/callback.html"
    },
    {
      "source": "/sync",
      "destination": "/sync.html"
    }
  ]
}